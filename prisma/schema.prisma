generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Founder {
  id                 String         @id @default(cuid())
  clerkId            String         @unique
  name               String
  email              String         @unique
  timezone           String         @default("UTC")
  workingHours       Json?
  subscriptionStatus String         @default("none")
  activeStartupId    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime       @updatedAt
  startups           Startup[]
  subscription       Subscription?
  copilotMessages    CopilotMessage[]

  // Community relations
  messages           Message[]
  forumPosts         ForumPost[]
  forumReplies       ForumReply[]
  forumVotes         ForumVote[]
  resources          Resource[]
  jobListings        JobListing[]
  coFounderPosts     CoFounderPost[]
  communityEvents    CommunityEvent[]
  eventRsvps         EventRSVP[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference?

}

model Startup {
  id              String           @id @default(cuid())
  founderId       String
  name            String
  stage           String           @default("idea")
  industry        String?
  website         String?
  description     String?
  targetCustomer  String?
  isPrimary       Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  founder         Founder          @relation(fields: [founderId], references: [id], onDelete: Cascade)
  goals           Goal[]
  standups        Standup[]
  blockers        Blocker[]
  evidence        Evidence[]
  recommendations Recommendation[]
  copilotMessages CopilotMessage[]
  weeklyReviews   WeeklyReview[]
  journalEntries  JournalEntry[]

  @@index([founderId])
}

model Goal {
  id                  String       @id @default(cuid())
  startupId           String
  title               String
  targetDate          DateTime?
  targetValue         Float?
  definitionOfSuccess String?
  status              String       @default("active")
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  startup             Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  milestones          Milestone[]

  @@index([startupId])
}

model Milestone {
  id        String   @id @default(cuid())
  goalId    String
  title     String
  status    String   @default("pending")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([goalId])
}

model Task {
  id              String       @id @default(cuid())
  milestoneId     String
  title           String
  description     String?
  status          String       @default("TODO")
  priority        String       @default("MEDIUM")
  estimateMinutes Int?
  dueDate         DateTime?
  scheduledFor    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  milestone       Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  blocker         Blocker?
  recommendations Recommendation[]

  @@index([milestoneId])
}

model Standup {
  id         String   @id @default(cuid())
  startupId  String
  date       DateTime @default(now())
  yesterday  String?
  today      String?
  blockers   String?
  createdAt  DateTime @default(now())
  startup    Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([startupId, date])
  @@index([startupId, date])
}

model Blocker {
  id              String    @id @default(cuid())
  startupId       String
  taskId          String?   @unique
  description     String
  status          String    @default("OPEN")
  sourceStandupId String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  startup         Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)
  task            Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([startupId])
}

model Evidence {
  id         String   @id @default(cuid())
  startupId  String
  type       String
  value      Float?
  note       String?
  recordedAt DateTime @default(now())
  startup    Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
}

model Recommendation {
  id            String    @id @default(cuid())
  startupId     String
  taskId        String?
  actionText    String
  rationale     String
  confidence    Float
  alternatives  Json?
  inputSnapshot Json?
  status        String    @default("GENERATED")
  feedback      String?
  generatedAt   DateTime  @default(now())
  startup       Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([startupId])
}

model CopilotMessage {
  id                String   @id @default(cuid())
  startupId         String
  founderId         String?
  role              String
  content           String
  contextSnapshotId String?
  createdAt         DateTime @default(now())
  startup           Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  founder           Founder? @relation(fields: [founderId], references: [id], onDelete: SetNull)

  @@index([startupId])
}

model WeeklyReview {
  id               String   @id @default(cuid())
  startupId        String
  weekStart        DateTime
  completedSummary String?
  blockersSummary  String?
  evidenceSummary  String?
  recommendedFocus String?
  createdAt        DateTime @default(now())
  startup          Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId, weekStart])
}

model JournalEntry {
  id        String   @id @default(cuid())
  startupId String
  type      String
  content   String
  createdAt DateTime @default(now())
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId, createdAt])
}

model Subscription {
  id                     String    @id @default(cuid())
  founderId              String    @unique
  provider               String    @default("razorpay")
  plan                   String    @default("trial")
  status                 String    @default("TRIAL")
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  founder                Founder   @relation(fields: [founderId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  founderId String?
  startupId String?
  event     String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([founderId, createdAt])
}

// --- Community Models ---

model Channel {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  founderId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  founder   Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([founderId])
}

model ForumCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  posts       ForumPost[]
  createdAt   DateTime    @default(now())
}

model ForumPost {
  id          String       @id @default(cuid())
  title       String
  content     String       @db.Text
  founderId   String
  founder     Founder      @relation(fields: [founderId], references: [id], onDelete: Cascade)
  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id])
  upvotes     Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  replies     ForumReply[]
  votes       ForumVote[]

  @@index([founderId])
  @@index([categoryId])
}

model ForumReply {
  id        String     @id @default(cuid())
  content   String     @db.Text
  postId    String
  post      ForumPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  founderId String
  founder   Founder    @relation(fields: [founderId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    ForumReply? @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ForumReply[] @relation("ReplyToReply")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([postId])
  @@index([founderId])
}

model ForumVote {
  id        String   @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  founderId String
  createdAt DateTime @default(now())
  founder   Founder   @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@unique([postId, founderId])
}

model Resource {
  id            String   @id @default(cuid())
  title         String
  description   String
  url           String
  category     String
  tags          String[]
  submittedById String
  isCurated    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  founder       Founder  @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([submittedById])
  @@index([category])
}

model JobListing {
  id          String   @id @default(cuid())
  title       String
  company     String
  description String
  location    String
  type        String
  url         String
  postedById  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  founder     Founder   @relation(fields: [postedById], references: [id], onDelete: Cascade)

  @@index([postedById])
}

model CoFounderPost {
  id                 String   @id @default(cuid())
  title              String
  description        String
  skillsNeeded       String[]
  skillsOffered      String[]
  locationPreference String?
  postedById         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  founder            Founder   @relation(fields: [postedById], references: [id], onDelete: Cascade)

  @@index([postedById])
}

model CommunityEvent {
  id          String   @id @default(cuid())
  title       String
  description String
  date        DateTime
  location    String
  type        String
  organizerId String
  capacity    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  organizer   Founder   @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  rsvps       EventRSVP[]

  @@index([organizerId])
}

model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  founderId String
  status    String
  createdAt DateTime @default(now())
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  founder   Founder        @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@unique([eventId, founderId])
}

model Notification {
  id        String   @id @default(cuid())
  founderId String
  type      String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  founder   Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@index([founderId])
  @@index([createdAt])
}

model NotificationPreference {
  id               String  @id @default(cuid())
  founderId        String  @unique
  emailEnabled     Boolean @default(true)
  inAppEnabled     Boolean @default(true)
  pushEnabled      Boolean @default(false)
  categorySettings Json    @default("{\"MENTION\": true, \"REPLY\": true, \"EVENT\": true, \"MILESTONE\": true, \"SYSTEM\": true}")
  founder          Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  startupId String
  name      String
  email     String
  status    String   @default("NEW")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startupId])
}

model WikiFolder {
  id        String     @id @default(cuid())
  startupId String
  name      String
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  pages     WikiPage[]

  @@index([startupId])
}

model WikiPage {
  id        String      @id @default(cuid())
  startupId String
  title     String
  content   String      @db.Text
  folderId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  folder    WikiFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([startupId])
  @@index([folderId])
}
