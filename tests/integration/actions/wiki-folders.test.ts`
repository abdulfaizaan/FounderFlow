import { describe, it, expect, vi, beforeEach } from 'vitest';
import { createWikiFolder, updateWikiFolder, deleteWikiFolder } from '@/lib/actions/wiki';
import { auth } from '@clerk/nextjs/server';
import { prisma } from '@/lib/prisma';
import { getActiveStartupIdForUser } from '@/lib/startup-context';

vi.mock('@/lib/startup-context', () => ({
  getActiveStartupIdForUser: vi.fn(),
}));

describe('Wiki Folder Security', () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it('should allow a user to create a folder in their own startup', async () => {
    const mockUserId = 'user_a';
    const mockStartupId = 'startup_a';

    (auth as any).mockResolvedValue({ userId: mockUserId });
    (getActiveStartupIdForUser as any).mockResolvedValue({
      startupId: mockStartupId,
      founder: { id: 'founder_a' },
    });

    prisma.wikiFolder.create.mockResolvedValue({ id: 'folder_a', name: 'Test' });

    await expect(createWikiFolder({ name: 'Test' })).resolves.toBeDefined();
    expect(prisma.wikiFolder.create).toHaveBeenCalledWith(
      expect.objectContaining({
        data: expect.objectContaining({ startupId: mockStartupId }),
      })
    );
  });

  it('should prevent updating a folder belonging to another startup', async () => {
    const mockUserId = 'user_a';
    const mockStartupId = 'startup_a';
    const victimFolderId = 'folder_b';

    (auth as any).mockResolvedValue({ userId: mockUserId });
    (getActiveStartupIdForUser as any).mockResolvedValue({
      startupId: mockStartupId,
      founder: { id: 'founder_a' },
    });

    // Prisma .update throws if the where clause (including startupId) doesn't match
    prisma.wikiFolder.update.mockRejectedValue(new Error('Record not found'));

    await expect(updateWikiFolder(victimFolderId, { name: 'Hacked' }))
      .rejects.toThrow();

    expect(prisma.wikiFolder.update).toHaveBeenCalledWith(
      expect.objectContaining({
        where: { id: victimFolderId, startupId: mockStartupId },
      })
    );
  });

  it('should prevent deleting a folder belonging to another startup', async () => {
    const mockUserId = 'user_a';
    const mockStartupId = 'startup_a';
    const victimFolderId = 'folder_b';

    (auth as any).mockResolvedValue({ userId: mockUserId });
    (getActiveStartupIdForUser as any).mockResolvedValue({
      startupId: mockStartupId,
      founder: { id: 'founder_a' },
    });

    prisma.wikiFolder.delete.mockRejectedValue(new Error('Record not found'));

    await expect(deleteWikiFolder(victimFolderId)).rejects.toThrow();
    expect(prisma.wikiFolder.delete).toHaveBeenCalledWith(
      expect.objectContaining({
        where: { id: victimFolderId, startupId: mockStartupId },
      })
    );
  });
});
